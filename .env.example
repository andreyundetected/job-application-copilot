# ============================================================
# LLM provider - only used by the automation pipeline (job
# evaluation, quick-filter, tailoring suggestions, question
# answering). Manual evaluation/tailoring/questions on the
# rest of the app also depend on this, since they call the
# same LLM providers.
#
# You only need ONE of the three key blocks below. Set
# LLM_PROVIDER to whichever one you filled in.
# During development this project was run against freellmapi
# (a local OpenAI-compatible proxy); openai/gemini work as
# drop-in alternatives if you'd rather use a hosted API key.
# ============================================================
LLM_PROVIDER=freellmapi

FREELLMAPI_KEY=
FREELLMAPI_BASE_URL=http://localhost:3001/v1
FREELLMAPI_MODEL=auto

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

DATABASE_URL=

TASK_MAX_WORKERS=25
AUTOMATION_MAX_WORKERS=10

# ============================================================
# Google search providers - ONLY used by the automation
# pipeline's job discovery step (searching Greenhouse/Lever/
# Ashby/etc. for postings). Nothing else in the app needs
# these; manual job evaluation, tailoring, and question
# answering work fine with both left empty.
#
# You only need ONE of the two keys below, but you can set
# both: if the first configured provider (in
# SEARCH_PROVIDER_ORDER) fails or errors out, the next one
# configured is tried automatically.
# ============================================================
SERPENT_API_KEY=
SERPENT_BASE_URL=https://apiserpent.com/api/search/quick

SERPER_API_KEY=
SERPER_BASE_URL=https://google.serper.dev/search

# Order to try configured search providers in (comma-separated).
# A provider with no API key set is skipped automatically.
SEARCH_PROVIDER_ORDER=serpent,serper 