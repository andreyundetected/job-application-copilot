# ============================================================
# LLM provider - only used by the automation pipeline (job
# evaluation, quick-filter, tailoring suggestions, question
# answering). Manual evaluation/tailoring/questions on the
# rest of the app also depend on this, since they call the
# same LLM providers.
#
# You only need ONE of the three key blocks below. Set
# LLM_PROVIDER to whichever one you filled in.
# During development this project was run against freellmapi
# (a local OpenAI-compatible proxy); openai/gemini work as
# drop-in alternatives if you'd rather use a hosted API key.
# ============================================================
LLM_PROVIDER=freellmapi

FREELLMAPI_KEY=
FREELLMAPI_BASE_URL=http://localhost:3001/v1
FREELLMAPI_MODEL=auto

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

DATABASE_URL=

# Separate database for the ATS discovery system (companies +
# postings found by crawling ATS boards directly). Kept apart
# from DATABASE_URL because it's a high-write, independent
# stream - defaults to its own sqlite file next to the main one.
DISCOVERY_DATABASE_URL=

TASK_MAX_WORKERS=25
AUTOMATION_MAX_WORKERS=10
DISCOVERY_POLL_MAX_WORKERS=8
DISCOVERY_WAYBACK_MAX_WORKERS=2
DISCOVERY_EVAL_MAX_WORKERS=3

# ============================================================
# Google search providers - legacy, only used if you still
# want ad-hoc keyword search on top of ATS discovery. Discovery
# itself (crawling known ATS boards) needs neither of these.
# ============================================================
SERPENT_API_KEY=
SERPENT_BASE_URL=https://apiserpent.com/api/search/quick

SERPER_API_KEY=
SERPER_BASE_URL=https://google.serper.dev/search

SEARCH_PROVIDER_ORDER=serper,serpent

# Telegram bot token/chat ID are configured in-app (Automation page),
# not here - stored in app_settings alongside other profile settings.