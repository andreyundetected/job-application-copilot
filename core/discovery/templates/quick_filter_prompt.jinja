<result id="{{ result.id }}">
title: {{ result.title }}
snippet: {{ result.snippet }}
url: {{ result.url }}
</result>
{% endfor %}

OUTPUT FORMAT
Respond using only the following tags, with no extra text outside them. Output exactly one <verdict> per result above, using the exact same id.

<verdict id="the exact id from the result above">skip or proceed</verdict>